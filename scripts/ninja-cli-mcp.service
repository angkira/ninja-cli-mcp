[Unit]
Description=ninja-cli-mcp module daemons (coder/researcher/agent)
Documentation=https://github.com/angkira/ninja-cli-mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h
ExecStart=%h/.local/bin/ninja-mcp-daemons start
ExecStop=%h/.local/bin/ninja-mcp-daemons stop
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180
TimeoutStopSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ninja-cli-mcp

# Lightweight hardening (keep home writable — AI CLIs cache there).
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
