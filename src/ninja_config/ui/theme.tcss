/* ─────────────────────────────────────────────────────────────
   Ninja MCP — Nord theme (shared by modern_tui + menuconfig_tui).
   Compact variant: tight paddings, underline-style inputs/selects and
   borderless containers. Palette lives in ui/theme.py; hex values below
   mirror it: Polar Night #2E3440 #3B4252 #434C5E #4C566A · Snow Storm
   #D8DEE9 #E5E9F0 #ECEFF4 · Frost #8FBCBB #88C0D0 #81A1C1 #5E81AC ·
   Aurora #BF616A #D08770 #EBCB8B #A3BE8C #B48EAD
   ───────────────────────────────────────────────────────────── */

/* ── Base ─────────────────────────────────────────────────── */
Screen {
    background: #2E3440;
    color: #D8DEE9;
}
Header {
    background: #3B4252;
    color: #ECEFF4;
}
Footer {
    background: #3B4252;
    color: #D8DEE9;
}
TabbedContent {
    height: 1fr;
}
TabbedContent Tabs {
    background: #3B4252;
}
TabbedContent Tabs Tab {
    background: #3B4252;
    color: #D8DEE9;
    padding: 0 1;
}
TabbedContent Tabs Tab.-active {
    background: #434C5E;
    color: #88C0D0;
    text-style: bold;
}
TabPane {
    padding: 0 1;
    background: #2E3440;
}
VerticalScroll {
    height: 1fr;
    scrollbar-color: #4C566A;
    scrollbar-background: #2E3440;
    scrollbar-corner-color: #2E3440;
}
Horizontal {
    height: auto;
}
Vertical {
    height: auto;
}
Static {
    color: #D8DEE9;
}
Label {
    color: #D8DEE9;
}

/* ── Section headers ──────────────────────────────────────── */
.section-header {
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}
Rule {
    color: #4C566A;
    margin: 0;
}

/* ── Inputs: compact underline (1-row content + bottom rule) ─ */
Input {
    background: #2E3440;
    color: #ECEFF4;
    border: none;
    border-bottom: solid #434C5E;
    padding: 0 1;
    height: auto;
    margin: 0 0 1 0;
}
Input:focus {
    border-bottom: solid #88C0D0;
    background: #3B4252;
}
Input:disabled {
    color: #4C566A;
}

/* ── Buttons: single-line chips (no borders) ──────────────── */
Button {
    margin: 0 1 0 0;
    height: 1;
    min-height: 1;
    max-height: 1;
    padding: 0 1;
    background: #3B4252;
    color: #D8DEE9;
    border: none;
}
Button:hover {
    background: #434C5E;
    color: #ECEFF4;
}
Button:focus {
    background: #4C566A;
    color: #ECEFF4;
    text-style: bold;
}
Button.-primary {
    background: #3B4252;
    color: #88C0D0;
}
Button.-primary:hover {
    background: #434C5E;
    color: #ECEFF4;
}
Button.-default {
    background: #3B4252;
    color: #D8DEE9;
}
Button.-default:hover {
    background: #434C5E;
    color: #ECEFF4;
}
Button.-error {
    background: #3B4252;
    color: #BF616A;
}
Button.-error:hover {
    background: #434C5E;
    color: #EBCB8B;
}
Button.-success {
    background: #3B4252;
    color: #A3BE8C;
}
Button.-success:hover {
    background: #434C5E;
    color: #ECEFF4;
}
/* Provider picker row: same compact chips */
.provider-row Button {
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0 1 0 0;
}

/* ── Select: compact underline, same language as inputs ───── */
Select {
    background: #2E3440;
    color: #ECEFF4;
    border: none;
    padding: 0;
    height: auto;
    margin: 0 0 1 0;
}
Select > SelectCurrent {
    background: #2E3440;
    color: #ECEFF4;
    border: none;
    border-bottom: solid #4C566A;
    padding: 0 1;
}
Select:focus > SelectCurrent {
    background: #3B4252;
    border: none;
    border-bottom: solid #88C0D0;
    text-style: bold;
}
SelectOverlay {
    background: #3B4252;
    border: round #5E81AC;
}

/* ── Model autocomplete picker (per-role Provider + Input + dropdown) ─ */
.model-picker {
    margin: 0 0 1 0;
    padding: 0;
    border: none;
}
.model-status {
    color: #4C566A;
    height: auto;
    margin: 0 0 1 0;
}
.model-loading {
    height: 1;
    margin: 0 0 1 0;
    color: #88C0D0;
}
.model-suggest {
    max-height: 12;
    border: none;
}
.model-suggest:focus {
    border: none;
}
.model-placeholder {
    padding: 0 1;
    color: #4C566A;
}

/* ── Switch: compact inline toggle ────────────────────────── */
Switch {
    border: none;
    padding: 0 1;
    height: auto;
    width: auto;
}

/* ── Modules tab: one toggle row per module ───────────────── */
.module-row {
    height: auto;
    margin: 0 0 1 0;
}
.module-label {
    width: 1fr;
    height: auto;
}
.module-row .module-install {
    margin: 0 0 0 1;
}

/* ── Lists focus ring (keyboard navigation must stay visible) ─────── */
ListView:focus {
    scrollbar-color: #88C0D0;
}
ListView > ListItem:focus {
    background: #434C5E;
}

/* ── Lists + model cards ──────────────────────────────────── */
ListView {
    height: auto;
    max-height: 14;
    background: #2E3440;
    scrollbar-color: #4C566A;
    scrollbar-background: #2E3440;
}
ListView > ListItem {
    padding: 0 1;
    color: #D8DEE9;
}
ListView > ListItem:hover {
    background: #3B4252;
}
ListView > ListItem.--highlight {
    background: #434C5E;
}
/* Model rows: flat, separated by a hairline instead of a full border */
.model-card {
    border: none;
    border-bottom: solid #3B4252;
    padding: 0 1;
    margin: 0;
    background: #2E3440;
}
.model-card:hover {
    background: #3B4252;
}
.model-card.--highlight {
    background: #434C5E;
    border-bottom: solid #88C0D0;
}
.model-card.current {
    border-bottom: solid #A3BE8C;
}

/* ── Collapsible role sections: borderless, tight ─────────── */
Collapsible {
    border: none;
    background: #2E3440;
    margin: 0 0 1 0;
    padding: 0;
}
CollapsibleTitle {
    color: #88C0D0;
    text-style: bold;
    padding: 0 1;
}

/* ── App-specific ids ─────────────────────────────────────── */
#main-tabs {
    height: 1fr;
}
#secrets-error-banner {
    color: #BF616A;
    height: auto;
}
#api-key-list {
    max-height: 16;
}
#settings-list {
    max-height: 16;
}

/* ── menuconfig_tui ids (same Nord theme, no solid cyan) ──── */
#breadcrumb {
    height: 1;
    margin-bottom: 0;
    color: #4C566A;
}
#menu-title {
    height: 1;
    content-align: center middle;
    text-style: bold;
    color: #88C0D0;
    margin-bottom: 1;
}
#menu-container {
    height: 1fr;
    border: none;
    border-top: solid #4C566A;
    padding: 0 1;
    background: #2E3440;
}
#menu-list {
    background: #2E3440;
}
#status-bar {
    height: 1;
    margin-top: 1;
    content-align: center middle;
    color: #4C566A;
}
